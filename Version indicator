cat << 'EOF' > index.html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Sovereign Trek | v1.0.2</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        :root { --accent: #1DB954; --bg: #0c0c0c; }
        body, html { margin: 0; padding: 0; width: 100%; height: 100%; background: var(--bg); font-family: 'Plus Jakarta Sans', sans-serif; color: white; display: flex; align-items: center; justify-content: center; }
        .card { background: rgba(20, 20, 20, 0.95); border: 1px solid rgba(255,255,255,0.1); border-radius: 28px; padding: 40px; text-align: center; width: 320px; position: relative; }
        .timer { font-size: 72px; font-weight: 800; margin: 10px 0; letter-spacing: -3px; }
        .dist-val { font-size: 32px; font-weight: 800; color: var(--accent); }
        .btn { background: white; color: black; border: none; padding: 15px; border-radius: 30px; font-weight: 800; cursor: pointer; width: 100%; transition: 0.2s; }
        .btn:hover { background: var(--accent); color: white; }
        .version-tag { position: absolute; bottom: 10px; right: 20px; font-size: 8px; opacity: 0.3; }
    </style>
</head>
<body>
    <div class="card">
        <div id="node-status" style="font-size: 9px; color: var(--accent); margin-bottom: 10px; font-weight: 800;">SYNCING...</div>
        <div style="font-size:10px; opacity:0.4; letter-spacing:2px;">CURRENT TREK</div>
        <div id="dist-ui" class="dist-val">0.0m</div>
        <div id="timer-display" class="timer">25:00</div>
        <button onclick="toggleTrek()" id="main-btn" class="btn">START TREK</button>
        <div class="version-tag">ST-v1.0.2-LIVE</div>
    </div>

    <script>
        let state = { active: false, time: 1500, totalSec: parseFloat(localStorage.getItem('trek_dist')) || 0 };
        
        window.onload = () => {
            const isGitHub = window.location.hostname.includes('github.io');
            document.getElementById('node-status').innerText = isGitHub ? "● LIVE GITHUB NODE" : "○ LOCAL NODE";
            render();
        };

        function render() {
            document.getElementById('dist-ui').innerText = (state.totalSec / 60).toFixed(1) + 'm';
            let m = Math.floor(state.time/60), s = state.time%60;
            document.getElementById('timer-display').innerText = `${m}:${s<10?'0':''}${s}`;
        }

        function toggleTrek() {
            state.active = !state.active;
            document.getElementById('main-btn').innerText = state.active ? "PAUSE" : "RESUME";
            document.getElementById('main-btn').style.background = state.active ? "#1DB954" : "white";
        }

        setInterval(() => {
            if(state.active && state.time > 0) {
                state.time--; 
                state.totalSec++; 
                localStorage.setItem('trek_dist', state.totalSec);
                render();
            }
        }, 1000);
    </script>
</body>
</html>
EOF
