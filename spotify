<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Trek Music App</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- Spotify iFrame API -->
<script src="https://open.spotify.com/embed/iframe-api/v1" async></script>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #0f0f0f;
      color: #fff;
      text-align: center;
    }

    h1 {
      margin: 20px 0;
    }

    .controls {
      margin: 15px;
    }

    button {
      padding: 10px 15px;
      margin: 5px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      background: #1db954;
      color: #000;
      font-weight: bold;
      transition: transform 0.2s;
    }

    button:hover {
      transform: scale(1.05);
    }

    button.secondary {
      background: #ff0000;
      color: #fff;
    }

    .player {
      display: none;
      margin-top: 20px;
    }

    iframe {
      border-radius: 12px;
      max-width: 90%;
      width: 360px;
      height: 215px;
    }
  </style>
</head>
<body>

  <h1>🎧 Trek Music</h1>

  <!-- Player Selection -->
  <div class="controls">
    <button onclick="showSpotify()">Spotify</button>
    <button class="secondary" onclick="showYouTube()">YouTube Music</button>
  </div>

  <!-- Load Specific Tracks/Playlists -->
  <div class="controls">
    <button onclick="loadSpotifyPlaylist()">Chill Playlist</button>
    <button onclick="loadSpotifyTrack()">Single Track</button>
    <button class="secondary" onclick="loadYouTubeSong()">YT Song</button>
  </div>

  <!-- Spotify Player -->
  <div id="spotify-container" class="player">
<div id="embed-iframe"></div>
  </div>

  <!-- YouTube Player -->
  <div id="youtube-container" class="player">
    <iframe
      id="yt-frame"
      src=""
      allow="autoplay; encrypted-media"
      allowfullscreen>
    </iframe>
  </div>

  <script>
    let spotifyController;

    // Spotify iFrame API ready
    window.onSpotifyIframeApiReady = (IFrameAPI) => {
      IFrameAPI.createController(
        document.getElementById('spotify-player'),
        {
          uri: 'spotify:playlist:37i9dQZF1EVJHK7Q1TBABQ'
        },
        (controller) => {
          spotifyController = controller;
        }
      );
    };

    // Show Spotify player
    function showSpotify() {
window.onSpotifyIframeApiReady = (IFrameAPI) => {
  //
};

      document.getElementById('youtube-container').style.display = 'none';
    }

    // Show YouTube player
    function showYouTube() {
      document.getElementById('spotify-container').style.display = 'none';
      document.getElementById('youtube-container').style.display = 'block';
    }

    // Load Spotify playlist
    function loadSpotifyPlaylist() {
      showSpotify();
      if window.onSpotifyIframeApiReady = (IFrameAPI) => {
  const element = document.getElementById('embed-iframe');
  const options = {
      uri: 'spotify:episode:7makk4oTQel546B0PZlDM5'
    };
  const callback = (EmbedController) => {};
  IFrameAPI.createController(element, options, callback);
};

    }

    // Load Spotify track
    function loadSpotifyTrack() {
      showSpotify();
      if (spotifyController) {
        spotifyController.loadUri('spotify:track:4cOdK2wGLETKBW3PvgPWqT');
      } else {
        alert("Spotify player not ready yet!");
      }
    }

    // Load YouTube song
    function loadYouTubeSong() {
      showYouTube();
      const ytFrame = document.getElementById('yt-frame');
      ytFrame.src = 'https://www.youtube.com/embed/ktvTqknDobU?autoplay=1';
    }
  </script>

</body>
</html>
