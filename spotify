<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Trek Music App</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- Spotify iFrame API -->
  <script src="https://open.spotify.com/embed/iframe-api/v1"></script>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #0f0f0f;
      color: #fff;
      text-align: center;
    }

    h1 {
      margin: 20px 0;
    }

    .controls {
      margin: 15px;
    }

    button {
      padding: 10px 15px;
      margin: 5px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      background: #1db954;
      color: #000;
      font-weight: bold;
    }

    button.secondary {
      background: #ff0000;
      color: #fff;
    }

    .player {
      display: none;
      margin-top: 20px;
    }

    iframe {
      border-radius: 12px;
    }
  </style>
</head>
<body>

  <h1>🎧 Trek Music</h1>

  <div class="controls">
    <button onclick="showSpotify()">Spotify</button>
    <button class="secondary" onclick="showYouTube()">YouTube Music</button>
  </div>

  <div class="controls">
    <button onclick="loadSpotifyPlaylist()">Chill Playlist</button>
    <button onclick="loadSpotifyTrack()">Single Track</button>
    <button class="secondary" onclick="loadYouTubeSong()">YT Song</button>
  </div>

  <!-- Spotify Player -->
  <div id="spotify-container" class="player">
    <div id="spotify-player"></div>
  </div>

  <!-- YouTube Player -->
  <div id="youtube-container" class="player">
    <iframe
      id="yt-frame"
      width="360"
      height="215"
      src=""
      allow="encrypted-media"
      allowfullscreen>
    </iframe>
  </div>

  <script>
    let spotifyController;

    window.onSpotifyIframeApiReady = (IFrameAPI) => {
      IFrameAPI.createController(
        document.getElementById('spotify-player'),
        {
          uri: 'spotify:playlist:37i9dQZF1EVJHK7Q1TBABQ'
        },
        (controller) => {
          spotifyController = controller;
        }
      );
    };

    function showSpotify() {
      document.getElementById('spotify-container').style.display = 'block';
      document.getElementById('youtube-container').style.display = 'none';
    }

    function showYouTube() {
      document.getElementById('spotify-container').style.display = 'none';
      document.getElementById('youtube-container').style.display = 'block';
    }

    function loadSpotifyPlaylist() {
      showSpotify();
      spotifyController.loadUri('spotify:playlist:37i9dQZF1EVJHK7Q1TBABQ');
    }

    function loadSpotifyTrack() {
      showSpotify();
      spotifyController.loadUri('spotify:track:4cOdK2wGLETKBW3PvgPWqT');
    }

    function loadYouTubeSong() {
      showYouTube();
      document.getElementById('yt-frame').src =
        'https://www.youtube.com/embed/ktvTqknDobU';
    }
  </script>

</body>
</html>
